# Publieke basis-URL, gebruikt voor canonical URL's, sitemap en structured data.
NEXT_PUBLIC_SITE_URL=https://vakconnectie.nl

# WhatsApp-nummer waarop aanvragen binnenkomen (internationaal formaat, alleen cijfers).
# Standaard: 31617347333 (+31 6 17 34 73 33).
NEXT_PUBLIC_WHATSAPP_NUMBER=31617347333

# Accounts, dashboards (/account, /mijn-bedrijf) en beheer (/beheer) zijn gebouwd
# maar staan uit. Pas op "true" zetten zodra authenticatie en database gekoppeld zijn.
ACCOUNTS_ENABLED=false
