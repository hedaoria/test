# Publieke basis-URL, gebruikt voor canonical URL's, sitemap en structured data.
NEXT_PUBLIC_SITE_URL=https://www.vakconnectie.nl

# Toont de demobalk bovenaan de site. Zet op "false" zodra echte profielen en
# opdrachten uit de database komen.
NEXT_PUBLIC_DEMO_MODE=true

# Schakelt de inlogcontrole in proxy.ts in voor /account, /mijn-bedrijf en /beheer.
# Laat uit zolang er nog geen authenticatie is gekoppeld.
AUTH_ENABLED=false
